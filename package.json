{
  "name": "gungnir-mcp",
  "version": "0.8.0",
  "description": "Official MCP integration for the Gungnir C++23 framework",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "gungnir-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinangeloperez327/gungnir-mcp.git"
  },
  "keywords": [
    "gungnir",
    "mcp",
    "model-context-protocol",
    "gnr",
    "cpp"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.9.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
